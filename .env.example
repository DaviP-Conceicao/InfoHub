# Exemplo seguro para desenvolvimento local.
# Copie este arquivo para .env.local e substitua apenas os placeholders locais.
# Nunca versione .env.local, chaves reais ou dados de conexão de produção.

# Banco de dados MySQL/MariaDB local.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=infohub_local
DATABASE_USER=infohub_local_user
DATABASE_PASSWORD=replace-with-a-local-secret

# URL da aplicação usada pelo cliente demonstrativo de ingestão e, opcionalmente,
# pelo teste manual de publicação.
INFOHUB_API_URL=http://localhost:3000
INFOHUB_BASE_URL=http://localhost:3000

# Chaves distintas para endpoints protegidos. Use valores locais exclusivos;
# não reutilize nem copie chaves de produção.
INGESTION_API_KEY=replace-with-a-local-ingestion-key
PUBLISH_API_KEY=replace-with-a-local-publish-key

# Cliente demonstrativo de ingestão. O dry-run impede envio à API.
INGESTION_DRY_RUN=true
INGESTION_MAX_CANDIDATES=5

# Pipeline RSS. O dry-run é o padrão e não cria artefatos persistentes.
# Deixe PIPELINE_RSS_URLS ausente para usar a fonte padrão definida no código.
# PIPELINE_RSS_URLS=https://example.invalid/feed.xml
PIPELINE_REQUEST_TIMEOUT_MS=15000
PIPELINE_MAX_ITEMS=25
PIPELINE_DRY_RUN=true
PIPELINE_BRONZE_DIR=scripts/pipeline/bronze/data
PIPELINE_SILVER_DIR=scripts/pipeline/silver/data
